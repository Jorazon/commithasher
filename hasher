#!/bin/bash

function hide_cursor() {
  printf '\033[?25l'
}

function show_cursor() {
  printf '\033[?25h'
}

function handle_int() {
  show_cursor
  exit 0
}

trap "handle_int" SIGINT

TARGET="000" # The default target pattern (3 leading zeros)
# If argument is passed, override only if it's valid hex
if [[ -n "$1" ]] && [[ "$1" =~ ^[0-9a-f]+$ ]]; then
  TARGET="$1"
elif [[ -n "$1" ]]; then
  echo "Error: '$1' contains invalid hexadecimal characters." >&2
  echo "       Only 0-9 and a-f (case-sensitive) are allowed." >&2
  exit 1
fi

# Retrieve the original message, timestamps and tree object from the HEAD commit
MESSAGE=$(git log -1 --pretty=format:"%s")
AUTHOR_DATE=$(git log -1 --format=%aI)
COMMITTER_DATE=$(git log -1 --format=%cI)
TREE=$(git write-tree)

# ASCII characters set: 0-9, A-F
#CHARS=({0..9} {A..F})

# invisible unicode characters
CHARS=('2000' '2001' '2002' '2003' '2004' '2005' '2006' '2007' \
'2008' '2009' '200A' '200B' '200C' '200D' '200E' '200F' '202F')

# Function to generate random trailing data
function generate_trailing_data() {
  TRAILING=""
  for i in {1..8}; do  # Length of trailing data, adjust as needed
    INDEX=$(( RANDOM % ${#CHARS[@]} ))
    TRAILING="${TRAILING}$(printf "\u${CHARS[$INDEX]}")"
  done
  echo "$TRAILING"
  return 0
}

function status_spinner() {
  # Setup for braille status indicator
  braille_chars=("⠇" "⠋" "⠙" "⠸" "⠴" "⠦")
  delay=0.066 # 15 fps
  i=0
  # Update status indicator
  while true; do
    echo -ne "${braille_chars[$((i % ${#braille_chars[@]}))]}\r"
    ((i++))
    sleep $delay
  done
}

# hide cursor
hide_cursor

echo -ne "  Finding a cool hash\r"

# Run spinner indicator in parallel and store it's PID
status_spinner &
PID1=$!

NEW_MESSAGE=""

while true; do
  # Generate trailing characters
  if TRAILING_DATA=$(generate_trailing_data); then
    # New commit message
    NEW_MESSAGE="$MESSAGE $TRAILING_DATA"
  else
    break
  fi

  # Create a new commit with `git commit-tree`
  HASH=$(GIT_AUTHOR_DATE="$AUTHOR_DATE" GIT_COMMITTER_DATE="$COMMITTER_DATE" \
    git commit-tree "$TREE" -p HEAD~1 -m "$NEW_MESSAGE")

  # Check if the hash matches the required pattern
  if [[ "$HASH" == $TARGET* ]]; then
    # Kill spinner indicator
    kill $PID1

    # Replace previous HEAD with new commit
    git reset --soft "$HASH"

    # Print info
    echo "Found matching hash: $HASH"
    #echo "Amending commit with #$TRAILING_DATA"
    break
  fi
done

# show cursor
show_cursor
