#!/bin/bash

function hide_cursor() {
  printf '\033[?25l'
}

function show_cursor() {
  printf '\033[?25h'
}

function handle_int() {
  show_cursor
  exit 0
}

trap "handle_int" SIGINT

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
HELPER_SOURCE="$SCRIPT_DIR/hasher-helper.c"
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    HELPER_BINARY="$SCRIPT_DIR/hasher-helper.exe"
    ;;
  *)
    HELPER_BINARY="$SCRIPT_DIR/hasher-helper"
    ;;
esac

TARGET="000" # The default target pattern (3 leading zeros)

for arg in "$@"; do
  if [[ "$arg" =~ ^[0-9a-f]+$ ]]; then
    TARGET="$arg"
  else
    echo "Error: '$arg' contains invalid hexadecimal characters." >&2
    echo "       Only 0-9 and a-f (case-sensitive) are allowed." >&2
    exit 1
  fi
done

# Retrieve the original message, identities and tree object from the HEAD commit
if ! MESSAGE=$(git log -1 --format=%B) ||
   ! AUTHOR_IDENTITY=$(git log -1 --format="%an <%ae> %ad" --date=raw) ||
   ! COMMITTER_IDENTITY=$(git log -1 --format="%cn <%ce> %cd" --date=raw) ||
   ! TREE=$(git write-tree) ||
   ! PARENT=$(git rev-parse --verify HEAD~1); then
  echo "Error: failed to read commit metadata. Is HEAD a non-root commit?" >&2
  exit 1
fi

function print_commit() {
  local nonce="$1"

  printf 'tree %s\n' "$TREE"
  printf 'parent %s\n' "$PARENT"
  printf 'author %s\n' "$AUTHOR_IDENTITY"
  printf 'committer %s\n' "$COMMITTER_IDENTITY"
  printf 'nonce %s\n' "$nonce"
  printf '\n'
  printf '%s' "$MESSAGE"
}

function create_commit() {
  local nonce="$1"
  local write="$2"

  if [[ "$write" -eq 1 ]]; then
    print_commit "$nonce" | git hash-object -t commit -w --stdin
  else
    #print_commit "$nonce" | git hash-object -t commit --stdin
    CONTENT_SIZE=$(print_commit "$nonce" | wc -c)
    {
      printf 'commit %s\0' "$CONTENT_SIZE"
      print_commit "$nonce"
    } | sha1sum | cut -d ' ' -f 1
  fi
}

function ensure_helper() {
  if [[ ! -x "$HELPER_BINARY" || "$HELPER_SOURCE" -nt "$HELPER_BINARY" ]]; then
    if ! gcc -O3 -std=c11 -Wall -Wextra -o "$HELPER_BINARY" "$HELPER_SOURCE"; then
      echo "Error: failed to build $HELPER_BINARY" >&2
      exit 1
    fi
  fi
}

function status_spinner() {
  # Setup for braille status indicator
  braille_chars=("⠇" "⠋" "⠙" "⠸" "⠴" "⠦")
  delay=0.066 # 15 fps
  i=0
  # Update status indicator
  while true; do
    echo -ne "${braille_chars[$((i % ${#braille_chars[@]}))]}\r"
    ((i++))
    sleep $delay
  done
}

ensure_helper

# hide cursor
hide_cursor

echo -ne "  Finding a cool hash\r"

# Run spinner indicator in parallel and store it's PID
status_spinner &
PID1=$!

HELPER_OUTPUT=$(print_commit "0000000000000000" | "$HELPER_BINARY" "$TARGET")
HELPER_STATUS=$?

# Kill spinner indicator
kill $PID1

if [[ "$HELPER_STATUS" -ne 0 ]]; then
  show_cursor
  exit "$HELPER_STATUS"
fi

read -r NONCE HASH ATTEMPTS ELAPSED_MS <<< "$HELPER_OUTPUT"
WRITTEN_HASH=$(create_commit "$NONCE" 1)

if [[ "$WRITTEN_HASH" != "$HASH" ]]; then
  show_cursor
  echo "Error: helper hash $HASH did not match written commit $WRITTEN_HASH" >&2
  exit 1
fi

# Replace previous HEAD with new commit
git reset --soft "$HASH"

RATE_MS=$ELAPSED_MS
if [[ "$RATE_MS" -lt 1 ]]; then
  RATE_MS=1
fi
HASHRATE=$((ATTEMPTS * 1000 / RATE_MS))

# Print info
echo "Found matching hash: $HASH"
echo "Amended commit with header $NONCE"
echo "Tested hashes: $ATTEMPTS"
printf 'Duration: %d.%03ds\n' "$((ELAPSED_MS / 1000))" "$((ELAPSED_MS % 1000))"
echo "Hashrate: ${HASHRATE} H/s"

# show cursor
show_cursor
